# Passwords need 8+ chars with upper, lower, digit and symbol (SQL Server rule).
# Avoid $ " ' \ and ; so they survive compose, bash and JDBC.
# Each login must have its own password: use three different values.
SA_PASSWORD=Change_me_sa_1!
SITE_DB_PASSWORD=Change_me_site_2!
EQUIPMENT_DB_PASSWORD=Change_me_equip_3!
